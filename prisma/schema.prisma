generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(STUDENT)
  allowance            Int       @default(0)
  trialPurchased       Boolean   @default(false)
  trialUsed            Boolean   @default(false)
  debateAccess         Boolean   @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  addonLessonsEnabled  Boolean   @default(false)
  upcomingLessons      Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  messages      Message[]
  courseAccess   UserCourseAccess[]
  lessonProgress UserLessonProgress[]
}


model Course {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String   @db.Text
  stripePriceId  String?
  order          Int      @default(0)
  isBundle       Boolean  @default(false)
  bundleIncludes String[]
  published      Boolean  @default(false)
  thumbnail      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lessons        CourseLesson[]
  userAccess     UserCourseAccess[]
}

model CourseLesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  vimeoId     String
  vimeoHash   String?
  duration    Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    UserLessonProgress[]
}

model UserCourseAccess {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([userId, courseId])
}

model UserLessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, lessonId])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(cuid())
  content     String   @db.Text
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAdmin   Boolean  @default(false)
  readByUser  Boolean  @default(false)
  readByAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProcessedWebhook {
  id          String   @id
  processedAt DateTime @default(now())
}

// First-party analytics. One row per tracked step; attribution is denormalised
// onto every row so the admin report can group without a join. `sessionId` is
// the unit of counting — "how many people reached checkout" means distinct
// sessions, not raw hits.
model TrackedEvent {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  // Funnel this step belongs to ('courses', 'platform-finder', 'lessons',
  // 'debate'). Null for plain page views outside any funnel.
  funnel    String?
  step      String?
  path      String
  // Derived bucket: direct | organic | paid_social | paid_search | referral | email | other
  channel   String   @default("direct")
  source    String?
  medium    String?
  campaign  String?
  // Purchase amount in USD, set only on 'purchased' steps.
  value     Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([funnel, step, createdAt])
  @@index([sessionId])
  @@index([channel, createdAt])
}

// Paid Platform Finder reports. The `id` is the shareable access token
// (/teachers/platform-finder?id=<id>) sent to the customer by email.
model PlatformFinderResult {
  id              String    @id
  answers         Json
  email           String?
  paid            Boolean   @default(false)
  emailedAt       DateTime?
  stripeSessionId String?   @unique
  createdAt       DateTime  @default(now())
}


generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubscriberAudience {
  STUDENT
  TEACHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(STUDENT)
  allowance            Int       @default(0)
  trialPurchased       Boolean   @default(false)
  trialUsed            Boolean   @default(false)
  debateAccess         Boolean   @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  addonLessonsEnabled  Boolean   @default(false)
  upcomingLessons      Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  messages      Message[]
  courseAccess   UserCourseAccess[]
  lessonProgress UserLessonProgress[]
  emailJourney   EmailJourney?
  campaignSends  EmailCampaignSend[]
}


model Course {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String   @db.Text
  stripePriceId  String?
  order          Int      @default(0)
  isBundle       Boolean  @default(false)
  bundleIncludes String[]
  published      Boolean  @default(false)
  thumbnail      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lessons        CourseLesson[]
  userAccess     UserCourseAccess[]
}

model CourseLesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  vimeoId     String
  vimeoHash   String?
  duration    Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    UserLessonProgress[]
}

model UserCourseAccess {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([userId, courseId])
}

model UserLessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, lessonId])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(cuid())
  content     String   @db.Text
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAdmin   Boolean  @default(false)
  readByUser  Boolean  @default(false)
  readByAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProcessedWebhook {
  id          String   @id
  processedAt DateTime @default(now())
}

// First-party analytics. One row per tracked step; attribution is denormalised
// onto every row so the admin report can group without a join. `sessionId` is
// the unit of counting — "how many people reached checkout" means distinct
// sessions, not raw hits.
model TrackedEvent {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  // Funnel this step belongs to ('courses', 'platform-finder', 'lessons',
  // 'debate'). Null for plain page views outside any funnel.
  funnel    String?
  step      String?
  path      String
  // Derived bucket: direct | organic | paid_social | paid_search | referral | email | other
  channel   String   @default("direct")
  source    String?
  medium    String?
  campaign  String?
  // Purchase amount in USD, set only on 'purchased' steps.
  value     Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([funnel, step, createdAt])
  @@index([sessionId])
  @@index([channel, createdAt])
}

// Paid Platform Finder reports. The `id` is the shareable access token
// (/teachers/platform-finder?id=<id>) sent to the customer by email.
model PlatformFinderResult {
  id              String    @id
  answers         Json
  email           String?
  paid            Boolean   @default(false)
  emailedAt       DateTime?
  stripeSessionId String?   @unique
  createdAt       DateTime  @default(now())
}

// Onboarding email journeys. One row per user *is* the enrolment: `step` counts
// the emails already sent and `nextSendAt` is when the following one is due
// (null once the journey has run out of steps). Keeping both on a single row
// lets the cron claim a send with one compare-and-swap update, so two
// overlapping runs can never post the same email twice.
model EmailJourney {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which sequence this user is on — 'student' or 'teacher'.
  journey        String
  step           Int       @default(0)
  nextSendAt     DateTime?
  lastSentAt     DateTime?
  // Consecutive send failures for the current step. The cron gives up on a row
  // once this passes its retry limit, so one dead address can't be retried
  // forever.
  attempts       Int       @default(0)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nextSendAt])
}

// The marketing list. Someone who gave their email to the signup popup in
// exchange for the welcome discount, without creating an account.
//
// Deliberately not a User: these people have no password, no role, nothing to
// log into, and folding them into User would put rows with no account into
// every admin count and every role-based query on the site. The cost is that
// the same person can exist here and as a User — that is fine, and the email
// unique index means the list itself never holds a duplicate.
//
// `audience` is the whole point of the popup. Teachers and students are sold
// completely different things, so an address with no audience on it is worth a
// fraction of one with it — which is why the form asks before it asks for the
// email, not after.
model Subscriber {
  id       String             @id @default(cuid())
  email    String             @unique
  name     String?
  audience SubscriberAudience
  /// Path the popup was answered on, so it's possible to see which pages
  /// actually earn signups. Null for anything submitted without one.
  source   String?
  /// Set once the welcome email with the discount code has gone out. Null
  /// means the row was written but the send failed — those are the ones worth
  /// looking at, since the person was promised a code they never received.
  welcomeSentAt  DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([audience])
  @@index([createdAt])
}

// One row per (person, campaign) that has actually been mailed.
//
// Campaigns are one-off broadcasts to a segment rather than a dated sequence,
// so there is nothing like EmailJourney.step to say where someone is up to —
// the only thing that matters is whether they have had it. The row is written
// *before* the send and deleted again if the send throws, so the unique
// constraint is what stops a re-run, an overlapping run, or a segment someone
// re-enters from mailing the same person twice.
model EmailCampaignSend {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Key from CAMPAIGNS in src/lib/email/campaigns.ts.
  campaign String
  sentAt   DateTime @default(now())

  @@unique([userId, campaign])
  @@index([campaign])
}
